# Environment Variables for Economics Learning Lab (Beta)
# Provision these values in the platform Settings > Secrets menu.

# The API key for OpenRouter (all /api/gemini/* AI endpoints run on
# deepseek/deepseek-v4-pro via OpenRouter as of the Gemini -> OpenRouter
# migration). Accessed server-side only. Do NOT prefix with VITE_ to keep it
# completely hidden from client devtools. Get a key at openrouter.ai/keys.
# NOTE: the OpenRouter workspace guardrail's Allowed Models list must include
# whichever model this resolves to, or requests get a 404 "no endpoints
# available matching your guardrail restrictions" (see /workspaces/default/guardrails).
OPENROUTER_API_KEY=

# Optional: override the OpenRouter model slug (defaults to
# deepseek/deepseek-v4-pro in code if unset).
OPENROUTER_MODEL=

# The API key for Tavily search, used only by /api/gemini/recommended-readings
# to ground its citations in real search results (no built-in web search on
# the OpenRouter/DeepSeek path, unlike Gemini's Google Search grounding tool
# this replaced).
TAVILY_API_KEY=

# No longer required by any endpoint after the DeepSeek/OpenRouter migration --
# left here in case a future feature reintroduces a Gemini-specific capability.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# URL of the Express backend. Only needed in dev with separate ports.
# Leave blank in production (unified server handles both).
VITE_API_URL=

# Supabase project URL and anon/public key (Dashboard > Settings > API).
# The anon key is designed to be exposed client-side, same as Firebase's own
# API key was -- access control is enforced by Postgres Row Level Security
# policies (see supabase_schema.sql), not by keeping this secret.
# VITE_SUPABASE_URL is also read server-side by server.ts's authMiddleware to
# build the JWKS endpoint it verifies Bearer tokens against (new Supabase
# projects default to asymmetric signing keys, verified via JWKS -- there is
# no shared secret to configure, unlike firebase-admin's verifyIdToken()).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL of the sidecar Python stats service container.
# Accessed server-side only. Falls back to localhost in local development.
PYTHON_BACKEND_URL=
