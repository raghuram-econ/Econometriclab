# Environment Variables for Economics Learning Lab (Beta)
# Provision these values in the platform Settings > Secrets menu.

# The API key for OpenRouter (all /api/gemini/* AI endpoints run on
# deepseek/deepseek-chat via OpenRouter as of the Gemini -> OpenRouter
# migration). Accessed server-side only. Do NOT prefix with VITE_ to keep it
# completely hidden from client devtools. Get a key at openrouter.ai/keys.
OPENROUTER_API_KEY=

# Optional: override the OpenRouter model slug (defaults to
# deepseek/deepseek-chat in code if unset).
OPENROUTER_MODEL=

# The API key for Tavily search, used only by /api/gemini/recommended-readings
# to ground its citations in real search results (no built-in web search on
# the OpenRouter/DeepSeek path, unlike Gemini's Google Search grounding tool
# this replaced).
TAVILY_API_KEY=

# No longer required by any endpoint after the DeepSeek/OpenRouter migration --
# left here in case a future feature reintroduces a Gemini-specific capability.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# URL of the Express backend. Only needed in dev with separate ports.
# Leave blank in production (unified server handles both).
VITE_API_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_DATABASE_ID=

# URL of the sidecar Python stats service container.
# Accessed server-side only. Falls back to localhost in local development.
PYTHON_BACKEND_URL=
