rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Helpers
    function isValidWorkspace(data) {
      return data.keys().hasAll(['lastUpdated']) &&
             data.lastUpdated == request.time &&
             (data.get('activeModule', '') is string) &&
             (data.get('selectedConceptId', null) == null || data.selectedConceptId is string);
    }

    function isValidModelRun(data) {
      return (!data.keys().hasAny(['timestamp']) || (data.timestamp is string && data.timestamp.size() <= 100)) &&
             (!data.keys().hasAny(['module']) || (data.module is string && data.module.size() <= 100)) &&
             (!data.keys().hasAny(['specification']) || (data.specification is string && data.specification.size() <= 20000)) &&
             (!data.keys().hasAny(['results']) || (data.results is map || data.results is list || data.results is string || data.results == null)) &&
             (!data.keys().hasAny(['interpretation']) || (data.interpretation == null || data.interpretation is string)) &&
             (!data.keys().hasAny(['notes']) || (data.notes is string && data.notes.size() <= 50000));
    }

    function isValidRobustness(data) {
      return (!data.keys().hasAny(['name']) || (data.name is string && data.name.size() <= 1000)) &&
             (!data.keys().hasAny(['specification']) || (data.specification is string && data.specification.size() <= 10000)) &&
             (!data.keys().hasAny(['results']) || (data.results is map || data.results is list || data.results is string || data.results == null));
    }

    function isValidReport(data) {
      return (!data.keys().hasAny(['timestamp']) || (data.timestamp is string && data.timestamp.size() <= 100)) &&
             (!data.keys().hasAny(['packType']) || (data.packType is string && data.packType.size() <= 100));
    }

    function isValidPinnedResult(data) {
      return data.keys().hasAll(['module', 'dependentVar', 'keyResult', 'sessionId', 'order']) &&
             data.module is string && data.module.size() <= 100 &&
             data.dependentVar is string && data.dependentVar.size() <= 100 &&
             data.keyResult is string && data.keyResult.size() <= 200 &&
             data.sessionId is string && data.sessionId.size() <= 128 &&
             data.order is int &&
             (!data.keys().hasAny(['timestamp']) || data.timestamp != null);
    }

    function isValidPipelineNote(data) {
      return data.keys().hasAll(['id', 'stageId', 'content', 'authorName', 'authorUid', 'createdAt']) &&
             data.keys().size() == 6 &&
             data.id is string && data.id.size() <= 128 &&
             data.stageId in ['ideation', 'data-cleaning', 'regression', 'manuscript'] &&
             data.content is string && data.content.size() <= 2000 &&
             data.authorName is string && data.authorName.size() <= 128 &&
             data.authorUid == request.auth.uid &&
             data.createdAt is string && data.createdAt.size() <= 128;
    }

    // Collection matches
    match /pipelineNotes/{noteId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.authorUid;
      allow create: if isSignedIn() && isValidId(noteId) && isValidPipelineNote(incoming());
      allow update: if isSignedIn() && isValidId(noteId) && existing().authorUid == request.auth.uid && isValidPipelineNote(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['content']);
      allow delete: if isSignedIn() && isValidId(noteId) && existing().authorUid == request.auth.uid;
    }

    match /users/{uid} {
      match /workspace/current {
        allow get: if isOwner(uid);
        allow write: if isOwner(uid) && isValidWorkspace(incoming());
      }

      match /modelRuns/{runId} {
        allow list: if isOwner(uid);
        allow get: if isOwner(uid) && isValidId(runId);
        allow create: if isOwner(uid) && isValidId(runId) && incoming().keys().hasAll(['timestamp', 'module', 'specification', 'results']) && isValidModelRun(incoming());
        allow update: if isOwner(uid) && isValidId(runId) && isValidModelRun(incoming()) &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['notes', 'interpretation']);
        allow delete: if isOwner(uid) && isValidId(runId);
      }

      match /robustness/{specId} {
        allow list: if isOwner(uid);
        allow get: if isOwner(uid) && isValidId(specId);
        allow create: if isOwner(uid) && isValidId(specId) && incoming().keys().hasAll(['name', 'results', 'specification']) && isValidRobustness(incoming());
        allow delete: if isOwner(uid) && isValidId(specId);
      }

      match /reports/{reportId} {
        allow list: if isOwner(uid);
        allow get: if isOwner(uid) && isValidId(reportId);
        allow create: if isOwner(uid) && isValidId(reportId) && incoming().keys().hasAll(['timestamp', 'packType']) && isValidReport(incoming());
        allow update: if isOwner(uid) && isValidId(reportId) && isValidReport(incoming());
        allow delete: if isOwner(uid) && isValidId(reportId);
      }

      match /pinnedResults/{pinnedId} {
        allow list: if isOwner(uid);
        allow get: if isOwner(uid) && isValidId(pinnedId);
        allow create: if isOwner(uid) && isValidId(pinnedId) && isValidPinnedResult(incoming());
        allow update: if isOwner(uid) && isValidId(pinnedId) && isValidPinnedResult(incoming());
        allow delete: if isOwner(uid) && isValidId(pinnedId);
      }
    }
  }
}
